# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# PostgreSQL connection (Railway gives you this as DATABASE_URL)
DATABASE_URL=postgres://user:password@host:5432/kangaroopostiweb
# Set to true when the database requires SSL (Railway, AWS RDS)
PGSSL=true

# Long random string for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# PaperTrail (the delivery app). The admin signs in with their PaperTrail account, and customers see its routes.
# PAPERTRAIL_API_KEY is the same value as WEBSITE_API_KEY in PaperTrail's backend/.env.
PAPERTRAIL_API_URL=http://localhost:4000
PAPERTRAIL_API_KEY=replace-with-the-shared-key

# Google Maps browser key for the route map in the portal. Restrict it to this site in Google Cloud (HTTP referrers).
GOOGLE_MAPS_API_KEY=
